{
  "name": "asym-web-simple",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package && cn build --content \"{app,components,lib}/**/*.{ts,tsx}\" --css app/globals.css --out lib/cn-tables.ts",
    "cn:build": "cn build --content \"{app,components,lib}/**/*.{ts,tsx}\" --css app/globals.css --out lib/cn-tables.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node --import ./scripts/register-typescript6-for-eslint.mjs ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx,.js,.jsx,.mjs",
    "lint:fix": "node --import ./scripts/register-typescript6-for-eslint.mjs ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx,.js,.jsx,.mjs --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "qa:e2e": "playwright test",
    "qa:visual": "playwright test tests/visual",
    "qa:visual:update": "playwright test tests/visual --update-snapshots",
    "qa:a11y": "playwright test tests/a11y",
    "qa:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "qa:stripe-api": "playwright test tests/e2e/stripe-giving-api.spec.ts",
    "test:unit": "vitest run",
    "payload": "payload --disable-transpile",
    "generate:types": "payload --disable-transpile generate:types",
    "generate:importmap": "payload --disable-transpile generate:importmap",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@payloadcms/db-postgres": "4.0.0-beta.11",
    "@payloadcms/next": "4.0.0-beta.11",
    "@payloadcms/plugin-mcp": "4.0.0-beta.11",
    "@payloadcms/richtext-lexical": "4.0.0-beta.11",
    "@payloadcms/storage-vercel-blob": "4.0.0-beta.11",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "payload": "4.0.0-beta.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.39.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@interfere/landmines": "0.1.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript/typescript6": "6.0.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.9.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.4.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-doctor": "^0.9.23",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "knip": "6.47.0",
    "patch-package": "^8.0.1",
    "postcss-less": "^7.1.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "svgo": "4.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "ultracite": "8.3.1",
    "vercel": "^66.2.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "trustedDependencies": [
    "esbuild",
    "msw",
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.4.5"
}
